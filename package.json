{
  "name": "my-qwik-empty-starter",
  "description": "Blank project with routing included",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "biome lint src/",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler dev",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251228.0",
    "@eslint/js": "latest",
    "@iconify-json/carbon": "^1.2.21",
    "@iconify-json/lucide": "^1.2.108",
    "@qwik.dev/core": "^2.0.0-beta.30",
    "@qwik.dev/router": "^2.0.0-beta.30",
    "@types/node": "24.10.0",
    "compiled-i18n": "latest",
    "globals": "17.0.0",
    "katex": "^0.16.45",
    "prettier": "3.7.4",
    "rehype-katex": "^7.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "ts-morph": "^27.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "typescript-plugin-css-modules": "latest",
    "unocss": "^66.6.7",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1",
    "wrangler": "4"
  },
  "dependencies": {
    "@biomejs/biome": "^2.4.15"
  }
}
